{
    "name": "directors-resale/platform",
    "description": "Backend foundation for the Directors Resale Platform.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.0",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,

    "scripts": {
        "post-autoload-dump": [
            "@php -r \"echo 'Autoload refreshed.'.PHP_EOL;\""
        ]
    }
}
